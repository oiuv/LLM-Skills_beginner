{
  "name": "llm-agent-beginner",
  "version": "1.0.0",
  "description": "从零开发完整指导学习 Agent 的工程教程",
  "private": true,
  "workspaces": [
    "examples/learning-agent-runtime"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:runtime",
    "test:all": "npm run test --workspaces --if-present",
    "tutorial": "npm --workspace @tutorial/learning-agent-runtime run demo",
    "test:runtime": "npm --workspace @tutorial/learning-agent-runtime test",
    "demo": "npm run tutorial",
    "demo:legacy": "cd PART6-Demo-Project && npm run start",
    "weather-server": "cd PART2-MCP-Server/weather-server && npm run start",
    "github-server": "cd PART2-MCP-Server/github-server && npm run start",
    "client-example": "cd PART3-MCP-Client/client-example && npm run start"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "agent",
    "skills",
    "llm",
    "tutorial"
  ],
  "license": "MIT"
}
